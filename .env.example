KONNECT_REGION=us
KONNECT_CONTROL_PLANE_ID=replace-with-konnect-control-plane-id
KONNECT_CONTROL_PLANE_ENDPOINT=replace-with-control-plane-hostname
KONNECT_TELEMETRY_ENDPOINT=replace-with-telemetry-hostname

# These default to the matching endpoint values if left empty.
KONNECT_CONTROL_PLANE_SERVER_NAME=
KONNECT_TELEMETRY_SERVER_NAME=

ROOT_CA_CN=konnect-root-ca
INTERMEDIATE_CA_CN=konnect-intermediate-ca
DP_CERT_CN=kong-dp.internal
DP_CERT_SAN=DNS:kong-dp.internal

KONG_IMAGE=kong/kong-gateway:3.15
